+#[cfg(feature = "threads")]
+mod interruption {
+    use std::{cell::RefCell, sync::Arc};
+
+    pub(crate) type Check = Arc<dyn Fn() -> bool + Send + Sync>;
+
+    std::thread_local! {
+        static CHECK: RefCell<Option<Check>> = const { RefCell::new(None) };
+    }
+
+    pub(crate) fn current() -> Option<Check> {
+        CHECK.with(|slot| slot.borrow().clone())
+    }
+
+    pub(crate) fn requested() -> bool {
+        CHECK.with(|slot| slot.borrow().as_ref().is_some_and(|check| check()))
+    }
+
+    /// Run the parallel GIF quantization pipeline with a cancellation check.
+    /// A cancelled pipeline returns no image.
+    pub fn with_cancel_check<T>(
+        check: impl Fn() -> bool + Send + Sync + 'static,
+        run: impl FnOnce() -> T,
+    ) -> Option<T> {
+        struct Restore(Option<Check>);
+        impl Drop for Restore {
+            fn drop(&mut self) {
+                CHECK.with(|slot| slot.replace(self.0.take()));
+            }
+        }
+
+        let _restore = Restore(CHECK.with(|slot| slot.replace(Some(Arc::new(check)))));
+        if requested() {
+            return None;
+        }
+        let output = run();
+        (!requested()).then_some(output)
+    }
+}
+
+#[cfg(feature = "threads")]
+pub use interruption::with_cancel_check;
